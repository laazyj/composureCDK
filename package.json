{
  "name": "composurecdk",
  "description": "Composable, lifecycle-managed AWS infrastructure built on AWS CDK — monorepo for the @composurecdk/* packages.",
  "engines": {
    "npm": ">=11"
  },
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx prettier:write",
    "verify": "nx verify",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laazyj/composureCDK.git"
  },
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "infrastructure-as-code",
    "iac",
    "composurecdk",
    "monorepo"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/laazyj/composureCDK/issues"
  },
  "homepage": "https://github.com/laazyj/composureCDK#readme",
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yaml,yml}": "prettier --write",
    ".github/workflows/*.yml": "npx nx actionlint --"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@composurecdk/eslint-plugin": "*",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "github-actionlint": "1.7.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "23.2.1",
    "prettier": "^3.9.7",
    "publint": "^0.3.24",
    "tshy": "^4.1.3",
    "typescript-eslint": "^8.70.1"
  }
}
