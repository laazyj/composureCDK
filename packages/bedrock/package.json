{
  "name": "@composurecdk/bedrock",
  "version": "0.10.2",
  "description": "Composable Amazon Bedrock model access: cross-Region inference profiles, invocation grants and alarms",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laazyj/composureCDK.git",
    "directory": "packages/bedrock"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "infrastructure-as-code",
    "iac",
    "composurecdk",
    "bedrock",
    "generative-ai",
    "inference-profile",
    "llm"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@composurecdk/cloudformation": "^0.10.0",
    "@composurecdk/cloudwatch": "^0.10.0",
    "@composurecdk/core": "^0.10.0",
    "@composurecdk/custom-resources": "^0.10.0",
    "@composurecdk/iam": "^0.10.0",
    "@composurecdk/logs": "^0.10.0",
    "aws-cdk-lib": "^2.166.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@composurecdk/cdk-testing": "*",
    "@types/node": "^26.6.1",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "nx": {
    "tags": [
      "scope:lib"
    ]
  }
}
