{
  "name": "@composurecdk/cloudfront",
  "version": "0.10.0",
  "description": "Composable CloudFront distribution builder with well-architected defaults",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laazyj/composureCDK.git",
    "directory": "packages/cloudfront"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "clean": "rm -rf dist .tshy .tshy-build",
    "build": "tshy",
    "typecheck": "tsc --noEmit",
    "check:exports": "attw --pack . --profile node16 && publint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "infrastructure-as-code",
    "iac",
    "composurecdk",
    "cloudfront",
    "cdn",
    "distribution"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@composurecdk/cloudformation": "^0.10.0",
    "@composurecdk/cloudwatch": "^0.10.0",
    "@composurecdk/core": "^0.10.0",
    "@composurecdk/s3": "^0.10.0",
    "aws-cdk-lib": "^2.124.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@composurecdk/cdk-testing": "*",
    "@types/node": "^26.6.1",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "nx": {
    "tags": [
      "scope:lib"
    ]
  }
}
