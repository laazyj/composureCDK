{
  "name": "@composurecdk/eslint-plugin",
  "version": "0.10.3",
  "description": "Internal ESLint plugin encoding ComposureCDK architectural invariants (tagged builders, lifecycle context, builder copy state).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laazyj/composureCDK.git",
    "directory": "packages/eslint-plugin"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "aws-cdk",
    "composurecdk",
    "static-analysis",
    "architecture"
  ],
  "author": "Jason Duffett (https://github.com/laazyj)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "nx": {
    "tags": [
      "scope:tooling"
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
