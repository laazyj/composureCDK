    "CrudApiAppseedCatalogue2B5BB9AA": {
      "DependsOn": [
        "CrudApiAppseedCatalogueExecutionRoleDefaultPolicy80086B5B",
        "CrudApiAppseedCatalogueExecutionRoleC352F68A",
      ],
      "Properties": {
        "Code": {
          "ZipFile": "
const SEED = [
  { name: "widget", description: "reference gadget seeded at deploy time" },
  { name: "sprocket", description: "reference gadget seeded at deploy time" },
];

exports.handler = async () => {
  const url = process.env.API_URL + "gadgets";
  for (const gadget of SEED) {
    const response = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(gadget),
    });
    if (!response.ok) {
      throw new Error(
        "Seeding " + gadget.name + " failed: " + response.status + " " + (await response.text()),
      );
    }
  }
};
",
        },
        "Environment": {
          "Variables": {
            "API_URL": {
              "Fn::Join": [
                "",
                [
                  "https://",
                  {
                    "Ref": "CrudApiAppapi10BB4639",
                  },
                  ".execute-api.",
                  {
                    "Ref": "AWS::Region",
                  },
                  ".",
