      "Properties": {
        "Code": {
          "ZipFile": "exports.handler = async (order) => {
  if (order.quantity > 10) {
    const error = new Error("Only 10 of " + order.sku + " in stock");
    error.name = "OutOfStock";
    throw error;
  }
  return { reserved: order.quantity };
};",
        },
        "Description": "Reserves stock for an order; throws OutOfStock past the limit",
        "Handler": "index.handler",
        "LoggingConfig": {
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "FulfilmentWorkflowcheckStockLogGroupB7E7D774",
